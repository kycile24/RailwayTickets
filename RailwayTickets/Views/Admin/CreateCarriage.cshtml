
@model RailwayTickets.Models.Carriage

<h2>@(Ui.Pick("Додати вагон", "Add carriage"))</h2>

<form asp-action="CreateCarriage" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <label>@(Ui.Pick("Номер вагона", "Carriage number"))</label>
    <input asp-for="CarriageNumber" type="number"
           class="form-control mb-2" />

    <label>@(Ui.Pick("Тип вагона", "Carriage type"))</label>
    <input asp-for="CarriageType" class="form-control mb-2" />

    <label>@(Ui.Pick("Кількість місць", "Seat count"))</label>
    <input asp-for="SeatCount" type="number"
           class="form-control mb-2" />

    <label>@(Ui.Pick("Потяг", "Train"))</label>
    <select asp-for="TrainId" class="form-select mb-3">
        @foreach (var train in ViewBag.Trains)
        {
            <option value="@train.Id">@train.TrainNumber</option>
        }
    </select>

    <button class="btn btn-success">@(Ui.Pick("Зберегти", "Save"))</button>
    <a asp-action="Carriages" class="btn btn-secondary">@(Ui.Pick("Назад", "Back"))</a>
</form>
