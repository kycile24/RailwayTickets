
@model IEnumerable<RailwayTickets.Models.Carriage>

<h2>@(Ui.Pick("Керування вагонами", "Manage carriages"))</h2>

<a asp-action="CreateCarriage" class="btn btn-success mb-3">
    @(Ui.Pick("Додати вагон", "Add carriage"))
</a>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>@(Ui.Pick("Номер", "Number"))</th>
            <th>@(Ui.Pick("Тип", "Type"))</th>
            <th>@(Ui.Pick("Місця", "Seats"))</th>
            <th>@(Ui.Pick("Потяг", "Train"))</th>
            <th>@(Ui.Pick("Дії", "Actions"))</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var carriage in Model)
        {
            <tr>
                <td>@carriage.CarriageNumber</td>
                <td>@carriage.CarriageType</td>
                <td>@carriage.SeatCount</td>
                <td>@carriage.Train.TrainNumber</td>
                <td>
                    <a asp-action="EditCarriage"
                       asp-route-id="@carriage.Id"
                       class="btn btn-sm btn-warning">
                        @(Ui.Pick("Редагувати", "Edit"))
                    </a>

                    <form asp-action="DeleteCarriage"
                          asp-route-id="@carriage.Id"
                          method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-danger"
                                onclick="return confirm('@(Ui.Pick("Видалити вагон", "Delete carriage"))?')">
                            @(Ui.Pick("Видалити", "Delete"))
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">@(Ui.Pick("Назад", "Back"))</a>
