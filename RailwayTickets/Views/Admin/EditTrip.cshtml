@model RailwayTickets.Models.Trip

@{
    ViewData["Title"] = Ui.Pick("Редагування рейсу", "Edit trip");
}

<h1>@(Ui.Pick("Редагування рейсу", "Edit trip"))</h1>

<p class="text-muted">
    @(Ui.Pick("Зміна розкладу та параметрів рейсу", "Update trip schedule and details")) @Model.TripNumber.
</p>

<hr />


<form asp-action="EditTrip"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Id"
           type="hidden" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <div class="mb-3">

        <label asp-for="TripNumber"
               class="form-label">
            @(Ui.Pick("Номер рейсу", "Trip number"))
        </label>

        <input asp-for="TripNumber"
               class="form-control" />

        <span asp-validation-for="TripNumber"
              class="text-danger">
        </span>

    </div>


    <div class="row">

        <div class="col-md-6 mb-3">

            <label class="form-label">
                @(Ui.Pick("Маршрут", "Route"))
            </label>

            <select asp-for="RouteId"
                    class="form-select">

                @foreach (var route in ViewBag.Routes)
                {
                    <option value="@route.Id">
                        @Ui.Station(route.StartStation) → @Ui.Station(route.EndStation)
                    </option>
                }

            </select>

        </div>


        <div class="col-md-6 mb-3">

            <label class="form-label">
                @(Ui.Pick("Потяг", "Train"))
            </label>

            <select asp-for="TrainId"
                    class="form-select">

                @foreach (var train in ViewBag.Trains)
                {
                    <option value="@train.Id">
                        @train.TrainNumber — @train.Type
                    </option>
                }

            </select>

        </div>

    </div>


    <div class="row">

        <div class="col-md-6 mb-3">

            <label asp-for="DepartureDate"
                   class="form-label">
                @(Ui.Pick("Відправлення", "Departure"))
            </label>

            <input asp-for="DepartureDate"
                   type="datetime-local"
                   class="form-control" />

        </div>


        <div class="col-md-6 mb-3">

            <label asp-for="ArrivalDate"
                   class="form-label">
                @(Ui.Pick("Прибуття", "Arrival"))
            </label>

            <input asp-for="ArrivalDate"
                   type="datetime-local"
                   class="form-control" />

            <span asp-validation-for="ArrivalDate"
                  class="text-danger">
            </span>

        </div>

    </div>


    <div class="mb-3">

        <label asp-for="BasePrice"
               class="form-label">
            @(Ui.Pick("Базова вартість", "Base fare"))
        </label>

        <input asp-for="BasePrice"
               class="form-control" />

        <span asp-validation-for="BasePrice"
              class="text-danger">
        </span>

    </div>


    <button type="submit"
            class="btn btn-primary">

        @(Ui.Pick("Зберегти зміни", "Save changes"))

    </button>


    <a asp-action="Trips"
       class="btn btn-secondary">

        @(Ui.Pick("Скасувати", "Cancel"))

    </a>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}