@{
    ViewData["Title"] = Ui.Pick("Адміністратор", "Administrator");
}

<h1>@(Ui.Pick("Панель адміністратора", "Administration"))</h1>
<a class="btn btn-outline-primary" asp-action="OperationLog">@(Ui.Pick("Журнал змін", "Change history"))</a>

<p class="text-muted">
    @(Ui.Pick("Керування залізничними рейсами та розкладом", "Manage railway trips and timetables")).
</p>

<hr />

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h2>@ViewBag.TripsCount</h2>
                <p>@(Ui.Pick("Рейсів", "Trips"))</p>

                <a asp-action="Trips"
                   class="btn btn-outline-primary">
                    @(Ui.Pick("Переглянути", "View"))
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h2>@ViewBag.TrainsCount</h2>
                <p>@(Ui.Pick("Потягів", "Trains"))</p>

                <a asp-action="Trains"
                   class="btn btn-outline-primary">
                    @(Ui.Pick("Переглянути", "View"))
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h2>@ViewBag.RoutesCount</h2>
                <p>@(Ui.Pick("Маршрутів", "Routes"))</p>

                <a asp-action="Routes"
                   class="btn btn-outline-primary">
                    @(Ui.Pick("Переглянути", "View"))
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h2>@ViewBag.TicketsCount</h2>
                <p>@(Ui.Pick("Квитків", "Tickets"))</p>

                <a asp-controller="Tickets"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    @(Ui.Pick("Переглянути", "View"))
                </a>
            </div>
        </div>
    </div>

</div>

<div class="d-flex flex-wrap gap-2 mb-3">

    <a asp-action="CreateTrip"
       class="btn btn-success">
        @(Ui.Pick("Додати новий рейс", "Add new trip"))
    </a>

    <a asp-action="Employees"
       class="btn btn-primary">
        @(Ui.Pick("Керування працівниками", "Manage employees"))
    </a>

    <a asp-action="Carriages"
       class="btn btn-primary">
        @(Ui.Pick("Керування вагонами", "Manage carriages"))
    </a>

</div>
