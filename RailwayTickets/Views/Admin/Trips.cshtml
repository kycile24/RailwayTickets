@model IEnumerable<RailwayTickets.Models.Trip>

@{
    ViewData["Title"] = Ui.Pick("Керування рейсами", "Manage trips");
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h1>@(Ui.Pick("Керування рейсами", "Manage trips"))</h1>

    <a asp-action="CreateTrip"
       class="btn btn-success">

        @(Ui.Pick("Додати рейс", "Add trip"))

    </a>

</div>


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


<table class="table table-bordered table-hover align-middle">

    <thead class="table-dark">

        <tr>
            <th>@(Ui.Pick("Рейс", "Trip"))</th>
            <th>@(Ui.Pick("Маршрут", "Route"))</th>
            <th>@(Ui.Pick("Потяг", "Train"))</th>
            <th>@(Ui.Pick("Відправлення", "Departure"))</th>
            <th>@(Ui.Pick("Прибуття", "Arrival"))</th>
            <th>@(Ui.Pick("Ціна", "Price"))</th>
            <th>@(Ui.Pick("Дії", "Actions"))</th>
        </tr>

    </thead>


    <tbody>

        @foreach (var trip in Model)
        {
            <tr>

                <td>@trip.TripNumber</td>

                <td>
                    @Ui.Station(trip.Route.StartStation)
                    →
                    @Ui.Station(trip.Route.EndStation)
                </td>

                <td>
                    @trip.Train.TrainNumber
                </td>

                <td>
                    @trip.DepartureDate.ToString("dd.MM.yyyy HH:mm")
                </td>

                <td>
                    @trip.ArrivalDate.ToString("dd.MM.yyyy HH:mm")
                </td>

                <td>
                    @trip.BasePrice.ToString("0.00") @(Ui.Pick("грн", "UAH"))
                </td>

                <td>

                    <a asp-action="EditTrip"
                       asp-route-id="@trip.Id"
                       class="btn btn-sm btn-warning">

                        @(Ui.Pick("Редагувати", "Edit"))

                    </a>
                    <form asp-action="DeleteTrip"
                          asp-route-id="@trip.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('@(Ui.Pick("Ви впевнені", "Are you sure")), @(Ui.Pick("що хочете видалити цей рейс", "you want to delete this trip"))?');">

                            @(Ui.Pick("Видалити", "Delete"))

                        </button>

                    </form>

                </td>

            </tr>
        }

    </tbody>

</table>


<a asp-action="Index"
   class="btn btn-secondary">

    @(Ui.Pick("Назад", "Back"))

</a>