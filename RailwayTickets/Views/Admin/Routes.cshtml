@model IEnumerable<RailwayTickets.Models.Route>

@{
    ViewData["Title"] = Ui.Pick("Маршрути", "Routes");
}

<h1>@(Ui.Pick("Маршрути", "Routes"))</h1>

<table class="table table-bordered table-hover">

    <thead class="table-dark">

        <tr>
            <th>@(Ui.Pick("Номер", "Number"))</th>
            <th>@(Ui.Pick("Назва", "Name"))</th>
            <th>@(Ui.Pick("Початкова станція", "Origin station"))</th>
            <th>@(Ui.Pick("Кінцева станція", "Destination station"))</th>
            <th>@(Ui.Pick("Дії", "Actions"))</th>
        </tr>

    </thead>

    <tbody>

<a asp-action="CreateRoute" class="btn btn-success mb-3">
    @(Ui.Pick("Додати маршрут", "Add route"))
</a>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


        @foreach (var route in Model)
        {
            <tr>

                <td>
                    @route.RouteNumber
                </td>

                <td>
                    @route.Name
                </td>

                <td>
                    @Ui.Station(route.StartStation)
                </td>

                <td>
                    @Ui.Station(route.EndStation)
                </td>

<td>
    <a asp-action="EditRoute"
       asp-route-id="@route.Id"
       class="btn btn-sm btn-warning">
        @(Ui.Pick("Редагувати", "Edit"))
    </a>

    <form asp-action="DeleteRoute"
          asp-route-id="@route.Id"
          method="post"
          class="d-inline">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-sm btn-danger"
                onclick="return confirm('@(Ui.Pick("Видалити маршрут", "Delete route"))?')">
            @(Ui.Pick("Видалити", "Delete"))
        </button>
    </form>
</td>

            </tr>

        }

    </tbody>

</table>


<a asp-action="Index"
   class="btn btn-secondary">

    @(Ui.Pick("Назад", "Back"))

</a>