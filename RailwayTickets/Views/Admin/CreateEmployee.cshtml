
<h2>Додати працівника</h2>

<form asp-action="CreateEmployee" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <label>ПІБ</label>
    <input name="fullName" class="form-control mb-2" required />

    <label>Логін</label>
    <input name="login" class="form-control mb-2" required />

    <label>Пароль</label>
    <input name="password" type="password"
           class="form-control mb-2" required />

    <label>Посада</label>
    <select name="role" class="form-select mb-3">
        <option value="Cashier">Касир</option>
        <option value="Administrator">Адміністратор</option>
    </select>

    <button type="submit" class="btn btn-success">Зберегти</button>
    <a asp-action="Employees" class="btn btn-secondary">Назад</a>
</form>
