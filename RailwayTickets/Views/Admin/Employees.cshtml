
@model IEnumerable<RailwayTickets.Models.Employee>

<h2>@(Ui.Pick("Керування працівниками", "Manage employees"))</h2>

<a asp-action="CreateEmployee" class="btn btn-success mb-3">
    @(Ui.Pick("Додати працівника", "Add employee"))
</a>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>@(Ui.Pick("ПІБ", "Full name"))</th>
            <th>@(Ui.Pick("Логін", "Username"))</th>
            <th>@(Ui.Pick("Посада", "Position"))</th>
            <th>@(Ui.Pick("Дії", "Actions"))</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.FullName</td>
                <td>@employee.Login</td>
                <td>@(employee is RailwayTickets.Models.Cashier
                    ? Ui.Pick("Касир", "Cashier") : Ui.Pick("Адміністратор", "Administrator"))</td>
                <td>
                    <a asp-action="EditEmployee"
                       asp-route-id="@employee.Id"
                       class="btn btn-sm btn-warning">
                        @(Ui.Pick("Редагувати", "Edit"))
                    </a>

                    <form asp-action="DeleteEmployee"
                          asp-route-id="@employee.Id"
                          method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('@(Ui.Pick("Видалити працівника", "Delete employee"))?')">
                            @(Ui.Pick("Видалити", "Delete"))
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">@(Ui.Pick("Назад", "Back"))</a>
