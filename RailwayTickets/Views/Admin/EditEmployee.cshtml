
@model RailwayTickets.Models.Employee

@{
    ViewData["Title"] = Ui.Pick("Редагувати працівника", "Edit employee");
}

<h2>@(Ui.Pick("Редагувати працівника", "Edit employee"))</h2>

<form asp-controller="Admin"
      asp-action="EditEmployee"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <div class="mb-3">
        <label>@(Ui.Pick("ПІБ", "Full name"))</label>
        <input name="fullName"
               value="@Model.FullName"
               class="form-control"
               required />
    </div>

    <div class="mb-3">
        <label>@(Ui.Pick("Логін", "Username"))</label>
        <input name="login"
               value="@Model.Login"
               class="form-control"
               required />
    </div>

    <div class="mb-3">
        <label>@(Ui.Pick("Пароль", "Password"))</label>
        <input name="password"
               type="password"
               class="form-control"
               required />
    </div>

    <button type="submit" class="btn btn-warning">
        @(Ui.Pick("Зберегти зміни", "Save changes"))
    </button>

    <a asp-controller="Admin"
       asp-action="Employees"
       class="btn btn-secondary">
        @(Ui.Pick("Назад", "Back"))
    </a>
</form>
