@model IEnumerable<RailwayTickets.Models.Train>

@{
    ViewData["Title"] = Ui.Pick("Потяги", "Trains");
}

<h1>@(Ui.Pick("Потяги", "Trains"))</h1>

<a asp-action="CreateTrain" class="btn btn-success mb-3">
    @(Ui.Pick("Додати потяг", "Add train"))
</a>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>@(Ui.Pick("Номер", "Number"))</th>
            <th>@(Ui.Pick("Тип", "Type"))</th>
            <th>@(Ui.Pick("Кількість вагонів", "Number of carriages"))</th>
            <th>@(Ui.Pick("Вагони", "Carriages"))</th>
            <th>@(Ui.Pick("Дії", "Actions"))</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var train in Model)
        {
            <tr>
                <td>
                    @train.TrainNumber
                </td>

                <td>
                    @train.Type
                </td>

                <td>
                    @train.CarriageCount
                </td>

                <td>
                    @if (train.Carriages != null)
                    {
                        foreach (var carriage in train.Carriages)
                        {
                            <div>
                                @(Ui.Pick("Вагон", "Carriage")) @carriage.CarriageNumber —
                                @carriage.CarriageType,
                                @carriage.SeatCount @(Ui.Pick("місць", "seats"))
                            </div>
                        }
                    }
                </td>

                <td>
                    <a asp-action="EditTrain"
                       asp-route-id="@train.Id"
                       class="btn btn-sm btn-warning">
                        @(Ui.Pick("Редагувати", "Edit"))
                    </a>

                    <form asp-action="DeleteTrain"
                          asp-route-id="@train.Id"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('@(Ui.Pick("Видалити потяг", "Delete train"))?')">
                            @(Ui.Pick("Видалити", "Delete"))
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">
    @(Ui.Pick("Назад", "Back"))
</a>
