@model List<RailwayTickets.ViewModels.OperationLogRow>
<h1>@(Ui.Pick("Журнал змін", "Change history"))</h1>
<table class="table table-striped">
    <thead><tr><th>№</th><th>@(Ui.Pick("Час", "Time")) UTC</th><th>@(Ui.Pick("Виконавець", "Performed by"))</th><th>@(Ui.Pick("Таблиця", "Table"))</th><th>ID @(Ui.Pick("запису", "record"))</th><th>@(Ui.Pick("Дія", "Action"))</th></tr></thead>
    <tbody>
    @foreach (var row in Model)
    {
        <tr><td>@row.Id</td><td>@row.OccurredUtc.ToString("dd.MM.yyyy HH:mm:ss")</td>
            <td>@row.Actor</td><td>@row.EntityName</td><td>@row.EntityId</td><td>@row.Operation</td></tr>
    }
    </tbody>
</table>
@if (Model.Count == 100)
{
    <a asp-action="OperationLog" asp-route-before="@Model.Last().Id">@(Ui.Pick("Старіші записи", "Older records"))</a>
}
<a asp-action="Index">@(Ui.Pick("До панелі адміністратора", "Back to administration"))</a>
