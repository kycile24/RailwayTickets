@model RailwayTickets.Models.Trip

@{
    ViewData["Title"] = Ui.Pick("Новий рейс", "New trip");
}

<h1>@(Ui.Pick("Додавання рейсу", "Create trip"))</h1>

<hr />


<form asp-action="CreateTrip"
      method="post">

    @Html.AntiForgeryToken()


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <div class="mb-3">

        <label asp-for="TripNumber"
               class="form-label">
            @(Ui.Pick("Номер рейсу", "Trip number"))
        </label>

        <input asp-for="TripNumber"
               class="form-control" />

        <span asp-validation-for="TripNumber"
              class="text-danger">
        </span>

    </div>


    <div class="row">

        <div class="col-md-6 mb-3">

            <label class="form-label">
                @(Ui.Pick("Маршрут", "Route"))
            </label>

            <select asp-for="RouteId"
                    class="form-select">

                <option value="">
                    @(Ui.Pick("Оберіть маршрут", "Choose a route"))
                </option>

                @foreach (var route in ViewBag.Routes)
                {
                    <option value="@route.Id">
                        @Ui.Station(route.StartStation) → @Ui.Station(route.EndStation)
                    </option>
                }

            </select>

            <span asp-validation-for="RouteId"
                  class="text-danger">
            </span>

        </div>


        <div class="col-md-6 mb-3">

            <label class="form-label">
                @(Ui.Pick("Потяг", "Train"))
            </label>

            <select asp-for="TrainId"
                    class="form-select">

                <option value="">
                    @(Ui.Pick("Оберіть потяг", "Choose a train"))
                </option>

                @foreach (var train in ViewBag.Trains)
                {
                    <option value="@train.Id">
                        @train.TrainNumber — @train.Type
                    </option>
                }

            </select>

            <span asp-validation-for="TrainId"
                  class="text-danger">
            </span>

        </div>

    </div>


    <div class="row">

        <div class="col-md-6 mb-3">

            <label asp-for="DepartureDate"
                   class="form-label">
                @(Ui.Pick("Дата та час відправлення", "Departure date and time"))
            </label>

            <input asp-for="DepartureDate"
                   type="datetime-local"
                   class="form-control" />

        </div>


        <div class="col-md-6 mb-3">

            <label asp-for="ArrivalDate"
                   class="form-label">
                @(Ui.Pick("Дата та час прибуття", "Arrival date and time"))
            </label>

            <input asp-for="ArrivalDate"
                   type="datetime-local"
                   class="form-control" />

            <span asp-validation-for="ArrivalDate"
                  class="text-danger">
            </span>

        </div>

    </div>


    <div class="mb-3">

        <label asp-for="BasePrice"
               class="form-label">
            @(Ui.Pick("Базова вартість", "Base fare"))
        </label>

        <input asp-for="BasePrice"
               class="form-control" />

        <span asp-validation-for="BasePrice"
              class="text-danger">
        </span>

    </div>


    <button type="submit"
            class="btn btn-success">

        @(Ui.Pick("Додати рейс", "Add trip"))

    </button>


    <a asp-action="Trips"
       class="btn btn-secondary">

        @(Ui.Pick("Скасувати", "Cancel"))

    </a>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}