@model IEnumerable<RailwayTickets.Models.Ticket>

@{
    ViewData["Title"] = Ui.Pick("Касир", "Cashier");
}

<h1>@(Ui.Pick("Робоче місце касира", "Cashier workspace"))</h1>

<p class="text-muted">
    @(Ui.Pick("Оформлення та контроль залізничних квитків", "Railway ticket administration")).
</p>

<hr />


@if (!Model.Any())
{
    <div class="alert alert-info">

        @(Ui.Pick("Квитків поки немає", "No tickets yet")).

    </div>
}
else
{
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">

            <tr>
                <th>@(Ui.Pick("Квиток", "Ticket"))</th>
                <th>@(Ui.Pick("Пасажир", "Passenger"))</th>
                <th>@(Ui.Pick("Маршрут", "Route"))</th>
                <th>@(Ui.Pick("Рейс", "Trip"))</th>
                <th>@(Ui.Pick("Місце", "Seat"))</th>
                <th>@(Ui.Pick("Ціна", "Price"))</th>
                <th>@(Ui.Pick("Статус", "Status"))</th>
                <th>@(Ui.Pick("Дії", "Actions"))</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var ticket in Model)
            {
                <tr>

                    <td>
                        @ticket.TicketNumber
                    </td>

                    <td>
                        @ticket.Passenger.FullName
                    </td>

                    <td>
                        @Ui.Station(ticket.Trip.Route.StartStation)
                        →
                        @Ui.Station(ticket.Trip.Route.EndStation)
                    </td>

                    <td>
                        @ticket.Trip.TripNumber
                    </td>

                    <td>
                        @ticket.SeatNumber
                    </td>

                    <td>
                        @ticket.Price.ToString("0.00") @(Ui.Pick("грн", "UAH"))
                    </td>

                    <td>

                        @if (ticket.Status == "Заброньовано")
                        {
                            <span class="badge bg-warning text-dark">
                                @(Ui.Pick("Заброньовано", "Reserved"))
                            </span>
                        }
                        else if (ticket.Status == "Оформлено")
                        {
                            <span class="badge bg-success">
                                @(Ui.Pick("Оформлено", "Issued"))
                            </span>
                        }
                        else if (ticket.Status == "Повернено")
                        {
                            <span class="badge bg-secondary">
                                @(Ui.Pick("Повернено", "Refunded"))
                            </span>
                        }
                        else if (ticket.Status == "Скасовано")
                        {
                            <span class="badge bg-danger">
                                @(Ui.Pick("Скасовано", "Cancelled"))
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Ui.Status(ticket.Status)
                            </span>
                        }

                    </td>

                    <td>

                        <a asp-controller="Tickets"
                           asp-action="Details"
                           asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-outline-primary mb-1">

                            @(Ui.Pick("Переглянути", "View"))

                        </a>


                        @if (ticket.Status == "Заброньовано")
                        {
                            <form asp-controller="Cashier"
                                  asp-action="IssueTicket"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@ticket.Id" />

                                <button type="submit"
                                        class="btn btn-sm btn-success mb-1">

                                    @(Ui.Pick("Оформити", "Issue ticket"))

                                </button>

                            </form>


                            <form asp-controller="Cashier"
                                  asp-action="CancelTicket"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@ticket.Id" />

                                <button type="submit"
                                        class="btn btn-sm btn-danger mb-1">

                                    @(Ui.Pick("Скасувати", "Cancel"))

                                </button>

                            </form>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>
}