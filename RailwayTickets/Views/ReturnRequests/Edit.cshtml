
@model RailwayTickets.Models.ReturnRequest

@{
    ViewData["Title"] = Ui.Pick("Редагування заявки", "Edit request");
}

<h2>@(Ui.Pick("Редагувати заявку на повернення", "Edit refund request"))</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label>@(Ui.Pick("Причина повернення", "Refund reason"))</label>
        <textarea name="reason" class="form-control"
                  required>@Model.Reason</textarea>
    </div>

    <div class="mb-3">
        <label>@(Ui.Pick("Касир", "Cashier"))</label>
        <select name="cashierId" class="form-select">
            <option value="">@(Ui.Pick("Без касира", "No cashier"))</option>

            @foreach (var cashier in ViewBag.Cashiers)
            {
                if (Model.CashierId == cashier.Id)
                {
                    <option value="@cashier.Id" selected>
                        @cashier.FullName
                    </option>
                }
                else
                {
                    <option value="@cashier.Id">
                        @cashier.FullName
                    </option>
                }
            }
        </select>
    </div>

    <button type="submit" class="btn btn-warning">
        @(Ui.Pick("Зберегти зміни", "Save changes"))
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        @(Ui.Pick("Назад", "Back"))
    </a>
</form>
