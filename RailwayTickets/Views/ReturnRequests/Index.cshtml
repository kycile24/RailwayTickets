
@model IEnumerable<RailwayTickets.Models.ReturnRequest>

@{
    ViewData["Title"] = Ui.Pick("Заявки на повернення", "Refund requests");
}

<h2>@(Ui.Pick("Заявки на повернення", "Refund requests"))</h2>
<a asp-action="Create" class="btn btn-success mb-3">
    @(Ui.Pick("Додати заявку", "Add request"))
</a>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>@(Ui.Pick("Квиток", "Ticket"))</th>
            <th>@(Ui.Pick("Пасажир", "Passenger"))</th>
            <th>@(Ui.Pick("Причина", "Reason"))</th>
            <th>@(Ui.Pick("Дата", "Date"))</th>
            <th>@(Ui.Pick("Статус", "Status"))</th>
            <th>@(Ui.Pick("Касир", "Cashier"))</th>
            <th>@(Ui.Pick("Дії", "Actions"))</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@request.Id</td>
                <td>@request.Ticket?.TicketNumber</td>
                <td>@request.Passenger?.FullName</td>
                <td>@request.Reason</td>
                <td>@request.RequestDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@Ui.Status(request.Status)</td>
                <td>@(request.Cashier?.FullName ?? "—")</td>

                <td>
                    @if (User.IsInRole("Cashier") && request.Status == "Очікує")
                    {
                        <form asp-action="Approve"
                              asp-route-id="@request.Id"
                              method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">
                                @(Ui.Pick("Схвалити", "Approve"))
                            </button>
                        </form>

                        <form asp-action="Reject"
                              asp-route-id="@request.Id"
                              method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-secondary">
                                @(Ui.Pick("Відхилити", "Reject"))
                            </button>
                        </form>
                    }

                    @if (!User.IsInRole("Client")) {
                    <a asp-action="Edit"
                       asp-route-id="@request.Id"
                       class="btn btn-sm btn-warning">
                        @(Ui.Pick("Редагувати", "Edit"))
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@request.Id"
                          method="post" class="d-inline">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('@(Ui.Pick("Видалити заявку", "Delete request"))?')">
                            @(Ui.Pick("Видалити", "Delete"))
                        </button>
                    </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
