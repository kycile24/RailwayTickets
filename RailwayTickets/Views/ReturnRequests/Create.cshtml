
@model RailwayTickets.Models.ReturnRequest

<h2>@(Ui.Pick("Додати заявку на повернення", "Add refund request"))</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <label>@(Ui.Pick("Квиток", "Ticket"))</label>
    <select name="ticketId" class="form-select mb-3" required>
        <option value="">@(Ui.Pick("Оберіть квиток", "Choose a ticket"))</option>

        @foreach (var ticket in ViewBag.Tickets)
        {
            if (ticket.Id == Model.TicketId)
            {
                <option value="@ticket.Id" selected>
                    @ticket.TicketNumber
                </option>
            }
            else
            {
                <option value="@ticket.Id">
                    @ticket.TicketNumber
                </option>
            }
        }
    </select>

    <label>@(Ui.Pick("Причина повернення", "Refund reason"))</label>
    <textarea name="reason"
              class="form-control mb-3"
              required></textarea>

    <button type="submit" class="btn btn-success">
        @(Ui.Pick("Створити заявку", "Create request"))
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        @(Ui.Pick("Назад", "Back"))
    </a>
</form>
