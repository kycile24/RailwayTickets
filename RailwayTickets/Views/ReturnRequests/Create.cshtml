
@model RailwayTickets.Models.ReturnRequest

<h2>Додати заявку на повернення</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <label>Квиток</label>
    <select name="ticketId" class="form-select mb-3" required>
        <option value="">Оберіть квиток</option>

        @foreach (var ticket in ViewBag.Tickets)
        {
            if (ticket.Id == Model.TicketId)
            {
                <option value="@ticket.Id" selected>
                    @ticket.TicketNumber
                </option>
            }
            else
            {
                <option value="@ticket.Id">
                    @ticket.TicketNumber
                </option>
            }
        }
    </select>

    <label>Причина повернення</label>
    <textarea name="reason"
              class="form-control mb-3"
              required></textarea>

    <button type="submit" class="btn btn-success">
        Створити заявку
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Назад
    </a>
</form>
