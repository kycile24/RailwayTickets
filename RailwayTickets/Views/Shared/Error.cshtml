@model RailwayTickets.Models.ErrorViewModel
@{ ViewData["Title"] = Ui.Pick("Помилка", "Error"); }
<h1>@Ui.Pick("Не вдалося виконати запит", "The request could not be completed")</h1>
@if (Model.ShowRequestId)
{
    <p>@Ui.Pick("Номер запиту", "Request ID"): <code>@Model.RequestId</code></p>
}
<a asp-controller="Trips" asp-action="Index">@Ui.Pick("До розкладу", "Back to the timetable")</a>
