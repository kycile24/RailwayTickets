@model IEnumerable<RailwayTickets.Models.Ticket>

@{
    ViewData["Title"] = "Квитки";
}

<h1>Квитки</h1>

<p class="text-muted">
    Перелік заброньованих квитків.
</p>

@if (User.IsInRole("Administrator")) {
<a asp-action="Create" class="btn btn-success mb-3">
    Додати квиток
</a>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


@if (!Model.Any())
{
    <div class="alert alert-info">

        Заброньованих квитків поки немає.

        <a asp-controller="Trips"
           asp-action="Index"
           class="alert-link">

            Знайти рейс

        </a>

    </div>
}
else
{
    <table class="table table-bordered table-hover">

        <thead class="table-dark">

            <tr>
                <th>Квиток</th>
                <th>Пасажир</th>
                <th>Маршрут</th>
                <th>Рейс</th>
                <th>Місце</th>
                <th>Ціна</th>
                <th>Статус</th>
                <th>Дії</th>
                <th></th>
            </tr>

        </thead>


        <tbody>

            @foreach (var ticket in Model)
            {
                <tr>

                    <td>
                        @ticket.TicketNumber
                    </td>

                    <td>
                        @ticket.Passenger.FullName
                    </td>

                    <td>
                        @ticket.Trip.Route.StartStation
                        →
                        @ticket.Trip.Route.EndStation
                    </td>

                    <td>
                        @ticket.Trip.TripNumber
                    </td>

                    <td>
                        @ticket.SeatNumber
                    </td>

                    <td>
                        @ticket.Price.ToString("0.00") грн
                    </td>

                    <td>
                        @ticket.Status
                    </td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-outline-primary">

                            Переглянути

                        </a>

                    </td>

<td>
    @if (User.IsInRole("Administrator")) {
    <a asp-action="Edit" asp-route-id="@ticket.Id"
       class="btn btn-sm btn-warning">
        Редагувати
    </a>

    <form asp-action="Delete" asp-route-id="@ticket.Id"
          method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-sm btn-danger"
                onclick="return confirm('Видалити квиток?')">
            Видалити
        </button>
    </form>
}
</td>

                </tr>
            }

        </tbody>

    </table>
}