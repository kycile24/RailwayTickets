@model IEnumerable<RailwayTickets.Models.Ticket>

@{
    ViewData["Title"] = Ui.Pick("Квитки", "Tickets");
}

<h1>@(Ui.Pick("Квитки", "Tickets"))</h1>

<p class="text-muted">
    @(Ui.Pick("Перелік заброньованих квитків", "Reserved tickets")).
</p>

@if (User.IsInRole("Administrator")) {
<a asp-action="Create" class="btn btn-success mb-3">
    @(Ui.Pick("Додати квиток", "Add ticket"))
</a>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


@if (!Model.Any())
{
    <div class="alert alert-info">

        @(Ui.Pick("Заброньованих квитків поки немає", "No reservations yet")).

        <a asp-controller="Trips"
           asp-action="Index"
           class="alert-link">

            @(Ui.Pick("Знайти рейс", "Find a trip"))

        </a>

    </div>
}
else
{
    <table class="table table-bordered table-hover">

        <thead class="table-dark">

            <tr>
                <th>@(Ui.Pick("Квиток", "Ticket"))</th>
                <th>@(Ui.Pick("Пасажир", "Passenger"))</th>
                <th>@(Ui.Pick("Маршрут", "Route"))</th>
                <th>@(Ui.Pick("Рейс", "Trip"))</th>
                <th>@(Ui.Pick("Місце", "Seat"))</th>
                <th>@(Ui.Pick("Ціна", "Price"))</th>
                <th>@(Ui.Pick("Статус", "Status"))</th>
                <th>@(Ui.Pick("Дії", "Actions"))</th>
                <th></th>
            </tr>

        </thead>


        <tbody>

            @foreach (var ticket in Model)
            {
                <tr>

                    <td>
                        @ticket.TicketNumber
                    </td>

                    <td>
                        @ticket.Passenger.FullName
                    </td>

                    <td>
                        @Ui.Station(ticket.Trip.Route.StartStation)
                        →
                        @Ui.Station(ticket.Trip.Route.EndStation)
                    </td>

                    <td>
                        @ticket.Trip.TripNumber
                    </td>

                    <td>
                        @ticket.SeatNumber
                    </td>

                    <td>
                        @ticket.Price.ToString("0.00") @(Ui.Pick("грн", "UAH"))
                    </td>

                    <td>
                        @Ui.Status(ticket.Status)
                    </td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-outline-primary">

                            @(Ui.Pick("Переглянути", "View"))

                        </a>

                    </td>

<td>
    @if (User.IsInRole("Administrator")) {
    <a asp-action="Edit" asp-route-id="@ticket.Id"
       class="btn btn-sm btn-warning">
        @(Ui.Pick("Редагувати", "Edit"))
    </a>

    <form asp-action="Delete" asp-route-id="@ticket.Id"
          method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-sm btn-danger"
                onclick="return confirm('@(Ui.Pick("Видалити квиток", "Delete ticket"))?')">
            @(Ui.Pick("Видалити", "Delete"))
        </button>
    </form>
}
</td>

                </tr>
            }

        </tbody>

    </table>
}