@model RailwayTickets.ViewModels.BookTicketViewModel

@{
    ViewData["Title"] = Ui.Pick("Бронювання квитка", "Ticket reservation");
}

<h1>@(Ui.Pick("Бронювання квитка", "Ticket reservation"))</h1>

<hr />


<div class="card mb-4">

    <div class="card-body">

        <h5>
            @Model.RouteName
        </h5>

        <p class="mb-1">
            @(Ui.Pick("Рейс", "Trip")):
            <strong>@Model.TripNumber</strong>
        </p>

        <p class="mb-1">
            @(Ui.Pick("Відправлення", "Departure")):
            @Model.DepartureDate.ToString("dd.MM.yyyy HH:mm")
        </p>

        <p class="mb-0">
            @(Ui.Pick("Вартість", "Fare")):
            <strong>@Model.Price.ToString("0.00") @(Ui.Pick("грн", "UAH"))</strong>
        </p>

    </div>

</div>


<form asp-controller="Tickets"
      asp-action="Book"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="TripId"
           type="hidden" />


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <h4>@(Ui.Pick("Вибір місця", "Choose a seat"))</h4>

    <div class="row mb-4">

        <div class="col-md-6">

            <label asp-for="CarriageNumber"
                   class="form-label">
            </label>

            <select asp-for="CarriageNumber"
                    class="form-select">

                <option value="">
                    @(Ui.Pick("Оберіть вагон", "Choose a carriage"))
                </option>

                @foreach (var carriage in ViewBag.Carriages)
                {
                    <option value="@carriage.CarriageNumber">

                        @(Ui.Pick("Вагон", "Carriage")) @carriage.CarriageNumber
                        — @carriage.CarriageType
                        (@carriage.SeatCount @(Ui.Pick("місць", "seats")))

                    </option>
                }

            </select>

            <span asp-validation-for="CarriageNumber"
                  class="text-danger">
            </span>

        </div>


        <div class="col-md-6">

            <label asp-for="SeatNumber"
                   class="form-label">
            </label>

            <input asp-for="SeatNumber"
                   class="form-control" />

            <span asp-validation-for="SeatNumber"
                  class="text-danger">
            </span>

        </div>

    </div>


    <h4>@(Ui.Pick("Пільга та послуги", "Discount and extras"))</h4>
    <label>@(Ui.Pick("Студентський квиток", "Student ID")) (@(Ui.Pick("пільга", "discount")) 50% @(Ui.Pick("на проїзд", "for travel")))
        <input asp-for="StudentCard" maxlength="24" class="form-control" />
    </label><span asp-validation-for="StudentCard" class="text-danger"></span>
    <p><label><input asp-for="Linen" /> @(Ui.Pick("Білизна", "Bedding")) (+60 @(Ui.Pick("грн", "UAH")))</label>
       <label><input asp-for="Drink" /> @(Ui.Pick("Напій", "Drink")) (+25 @(Ui.Pick("грн", "UAH")))</label></p>
    <h4>@(Ui.Pick("Дані пасажира", "Passenger information"))</h4>
    @if (User.IsInRole("Cashier"))
    {
        <label>@(Ui.Pick("Логін зареєстрованого клієнта", "Registered passenger username")) (@(Ui.Pick("якщо є", "if applicable")))
            <input asp-for="ClientLogin" class="form-control" />
        </label><span asp-validation-for="ClientLogin" class="text-danger"></span>
    }


    <div class="mb-3">

        <label asp-for="FullName"
               class="form-label">
        </label>

        <input readonly="@(User.IsInRole("Client"))" asp-for="FullName"
               class="form-control" />

        <span asp-validation-for="FullName"
              class="text-danger">
        </span>

    </div>


    <div class="row">

        <div class="col-md-6 mb-3">

            <label asp-for="Phone"
                   class="form-label">
            </label>

            <input readonly="@(User.IsInRole("Client"))" asp-for="Phone"
                   class="form-control" />

            <span asp-validation-for="Phone"
                  class="text-danger">
            </span>

        </div>


        <div class="col-md-6 mb-3">

            <label asp-for="Email"
                   class="form-label">
            </label>

            <input readonly="@(User.IsInRole("Client"))" asp-for="Email"
                   class="form-control" />

            <span asp-validation-for="Email"
                  class="text-danger">
            </span>

        </div>

    </div>


    <div class="mb-4">

        <label asp-for="Document"
               class="form-label">
        </label>

        <input readonly="@(User.IsInRole("Client"))" asp-for="Document"
               class="form-control" />

        <span asp-validation-for="Document"
              class="text-danger">
        </span>

    </div>


    <button type="submit"
            class="btn btn-success">

        @(Ui.Pick("Забронювати квиток", "Book ticket"))

    </button>

    <a asp-controller="Trips"
       asp-action="Details"
       asp-route-id="@Model.TripId"
       class="btn btn-secondary">

        @(Ui.Pick("Скасувати", "Cancel"))

    </a>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}