
@model RailwayTickets.Models.Ticket

<h2>@(Ui.Pick("Редагувати квиток", "Edit ticket"))</h2>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <label>@(Ui.Pick("Номер квитка", "Ticket number"))</label>
    <input asp-for="TicketNumber" class="form-control mb-2" />

    <label>@(Ui.Pick("Пасажир", "Passenger"))</label>
    <select asp-for="PassengerId" class="form-select mb-2">
        @foreach (var p in ViewBag.Passengers)
        {
            <option value="@p.Id">@p.FullName</option>
        }
    </select>

    <label>@(Ui.Pick("Рейс", "Trip"))</label>
    <select asp-for="TripId" class="form-select mb-2">
        @foreach (var t in ViewBag.Trips)
        {
            <option value="@t.Id">@t.TripNumber</option>
        }
    </select>

    <label>@(Ui.Pick("Номер вагона", "Carriage number"))</label>
    <input asp-for="CarriageNumber" type="number" class="form-control mb-2" />

    <label>@(Ui.Pick("Номер місця", "Seat number"))</label>
    <input asp-for="SeatNumber" type="number" class="form-control mb-2" />

    <label>@(Ui.Pick("Ціна", "Price"))</label>
    <input asp-for="Price" type="number" step="0.01" class="form-control mb-2" />

    <label>@(Ui.Pick("Статус", "Status"))</label>
    <select asp-for="Status" class="form-select mb-2">
        <option value="@Model.Status">@Ui.Status(Model.Status)</option>
        @if (Model.Status == "Заброньовано") { <option value="Скасовано">@(Ui.Pick("Скасовано", "Cancelled"))</option> }
    </select>

    <label>@(Ui.Pick("Касир", "Cashier"))</label>
    <select asp-for="CashierId" class="form-select mb-3">
        <option value="">@(Ui.Pick("Без касира", "No cashier"))</option>
        @foreach (var c in ViewBag.Cashiers)
        {
            <option value="@c.Id">@c.FullName</option>
        }
    </select>

    <button type="submit" class="btn btn-warning">@(Ui.Pick("Зберегти зміни", "Save changes"))</button>
    <a asp-action="Index" class="btn btn-secondary">@(Ui.Pick("Назад", "Back"))</a>
</form>
