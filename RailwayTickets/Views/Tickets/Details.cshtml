@model RailwayTickets.Models.Ticket

@{
    ViewData["Title"] = "Квиток";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<div class="card shadow-sm">

    <div class="card-header">

        <strong>
            Електронний квиток
        </strong>

    </div>


    <div class="card-body">

        <h3>
            @Model.TicketNumber
        </h3>

        <hr />


        <div class="row">

            <div class="col-md-6">

                <p>
                    <strong>Пасажир:</strong><br />
                    @Model.Passenger.FullName
                </p>

                <p>
                    <strong>Документ:</strong><br />
                    @Model.Passenger.Document
                </p>

                <p>
                    <strong>Телефон:</strong><br />
                    @Model.Passenger.Phone
                </p>

            </div>


            <div class="col-md-6">

                <p>
                    <strong>Маршрут:</strong><br />

                    @Model.Trip.Route.StartStation
                    →
                    @Model.Trip.Route.EndStation
                </p>

                <p>
                    <strong>Рейс:</strong><br />
                    @Model.Trip.TripNumber
                </p>

                <p>
                    <strong>Відправлення:</strong><br />

                    @Model.Trip.DepartureDate
                    .ToString("dd.MM.yyyy HH:mm")
                </p>

            </div>

        </div>


        <hr />


        <div class="row">

            <div class="col-md-4">

                <strong>Вагон @Model.CarriageNumber · Місце</strong>

                <div class="fs-4">
                    @Model.SeatNumber
                </div>

            </div>


            <div class="col-md-4">

                <strong>Вартість</strong>

                <div class="fs-4">
                    @Model.Price.ToString("0.00") грн
                </div>

            </div>


            <div class="col-md-4">

                <strong>Статус</strong>

                <div>
                    <span class="badge bg-warning text-dark fs-6">
                        @Model.Status
                    </span>
                </div>

            </div>

        </div>

    </div>

</div>


<div class="mt-4 d-print-none">

    <a asp-controller="Tickets"
       asp-action="Index"
       class="btn btn-primary">

        Мої квитки

    </a>

    <a asp-controller="Trips"
       asp-action="Index"
       class="btn btn-secondary">

        Знайти інший рейс

    </a>

</div>
<p>Послуги: білизна — @(Model.Linen ? "так" : "ні"), напій — @(Model.Drink ? "так" : "ні"). Студентська пільга — @(string.IsNullOrEmpty(Model.StudentCard) ? "ні" : "так").</p>
@if ((Model.Status == "Оформлено" || Model.Status == "Оплачено") && User.IsInRole("Cashier"))
{
    <button class="btn btn-outline-primary d-print-none" onclick="window.print()">Друкувати дублікат</button>
    <h2 class="d-none d-print-block">Дублікат квитка №@Model.TicketNumber</h2>
}
@if ((Model.Status == "Оформлено" || Model.Status == "Оплачено") && Model.Trip!.DepartureDate > DateTime.Now)
{
    <a asp-controller="ReturnRequests"
       asp-action="Create"
       asp-route-ticketId="@Model.Id"
       class="btn btn-danger d-print-none">

        Повернути квиток

    </a>
}