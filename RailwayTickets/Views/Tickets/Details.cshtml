@model RailwayTickets.Models.Ticket

@{
    ViewData["Title"] = Ui.Pick("Квиток", "Ticket");
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
<div class="card shadow-sm">

    <div class="card-header">

        <strong>
            @(Ui.Pick("Електронний квиток", "Electronic ticket"))
        </strong>

    </div>


    <div class="card-body">

        <h3>
            @Model.TicketNumber
        </h3>

        <hr />


        <div class="row">

            <div class="col-md-6">

                <p>
                    <strong>@(Ui.Pick("Пасажир", "Passenger")):</strong><br />
                    @Model.Passenger.FullName
                </p>

                <p>
                    <strong>@(Ui.Pick("Документ", "Document")):</strong><br />
                    @Model.Passenger.Document
                </p>

                <p>
                    <strong>@(Ui.Pick("Телефон", "Phone")):</strong><br />
                    @Model.Passenger.Phone
                </p>

            </div>


            <div class="col-md-6">

                <p>
                    <strong>@(Ui.Pick("Маршрут", "Route")):</strong><br />

                    @Ui.Station(Model.Trip.Route.StartStation)
                    →
                    @Ui.Station(Model.Trip.Route.EndStation)
                </p>

                <p>
                    <strong>@(Ui.Pick("Рейс", "Trip")):</strong><br />
                    @Model.Trip.TripNumber
                </p>

                <p>
                    <strong>@(Ui.Pick("Відправлення", "Departure")):</strong><br />

                    @Model.Trip.DepartureDate
                    .ToString("dd.MM.yyyy HH:mm")
                </p>

            </div>

        </div>


        <hr />


        <div class="row">

            <div class="col-md-4">

                <strong>@(Ui.Pick("Вагон", "Carriage")) @Model.CarriageNumber · @(Ui.Pick("Місце", "Seat"))</strong>

                <div class="fs-4">
                    @Model.SeatNumber
                </div>

            </div>


            <div class="col-md-4">

                <strong>@(Ui.Pick("Вартість", "Fare"))</strong>

                <div class="fs-4">
                    @Model.Price.ToString("0.00") @(Ui.Pick("грн", "UAH"))
                </div>

            </div>


            <div class="col-md-4">

                <strong>@(Ui.Pick("Статус", "Status"))</strong>

                <div>
                    <span class="badge bg-warning text-dark fs-6">
                        @Ui.Status(Model.Status)
                    </span>
                </div>

            </div>

        </div>

    </div>

</div>


<div class="mt-4 d-print-none">

    <a asp-controller="Tickets"
       asp-action="Index"
       class="btn btn-primary">

        @(Ui.Pick("Мої квитки", "My tickets"))

    </a>

    <a asp-controller="Trips"
       asp-action="Index"
       class="btn btn-secondary">

        @(Ui.Pick("Знайти інший рейс", "Find another trip"))

    </a>

</div>
<p>@(Ui.Pick("Послуги", "Services")): @(Ui.Pick("білизна", "bedding")) — @(Model.Linen ? Ui.Pick("так", "yes") : Ui.Pick("ні", "no")), @(Ui.Pick("напій", "drink")) — @(Model.Drink ? Ui.Pick("так", "yes") : Ui.Pick("ні", "no")). @(Ui.Pick("Студентська пільга", "Student discount")) — @(string.IsNullOrEmpty(Model.StudentCard) ? Ui.Pick("ні", "no") : Ui.Pick("так", "yes")).</p>
@if ((Model.Status == "Оформлено" || Model.Status == "Оплачено") && User.IsInRole("Cashier"))
{
    <button class="btn btn-outline-primary d-print-none" onclick="window.print()">@(Ui.Pick("Друкувати дублікат", "Print duplicate"))</button>
    <h2 class="d-none d-print-block">@(Ui.Pick("Дублікат квитка", "Duplicate ticket")) №@Model.TicketNumber</h2>
}
@if ((Model.Status == "Оформлено" || Model.Status == "Оплачено") && Model.Trip!.DepartureDate > DateTime.Now)
{
    <a asp-controller="ReturnRequests"
       asp-action="Create"
       asp-route-ticketId="@Model.Id"
       class="btn btn-danger d-print-none">

        @(Ui.Pick("Повернути квиток", "Request refund"))

    </a>
}