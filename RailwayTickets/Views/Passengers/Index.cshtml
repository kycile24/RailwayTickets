@model IEnumerable<RailwayTickets.Models.Passenger>

@{
    ViewData["Title"] = Ui.Pick("Пасажири", "Passengers");
}
<a asp-controller="Passengers"
   asp-action="Create"
   class="btn btn-success mb-3">
    @(Ui.Pick("Додати пасажира", "Add passenger"))
</a>
<h1>@(Ui.Pick("Пасажири", "Passengers"))</h1>

<p class="text-muted">
    @(Ui.Pick("Перелік пасажирів", "Passenger list")), @(Ui.Pick("які здійснювали бронювання квитків", "who have booked tickets")).
</p>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (!Model.Any())
{
    <div class="alert alert-info">
        @(Ui.Pick("Пасажирів поки немає", "No passengers yet")).
        @(Ui.Pick("Пасажир з'явиться після бронювання першого квитка", "The passenger will appear after the first reservation")).
    </div>
}
else
{
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">
            <tr>
                <th>№</th>
                <th>@(Ui.Pick("ПІБ", "Full name"))</th>
                <th>@(Ui.Pick("Телефон", "Phone"))</th>
                <th>Email</th>
                <th>@(Ui.Pick("Документ", "Document"))</th>
                <th>@(Ui.Pick("Дії", "Actions"))</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var passenger in Model)
            {
                <tr>
                    <td>@passenger.Id</td>

                    <td>@passenger.FullName</td>

                    <td>@passenger.Phone</td>

                    <td>
                        @(string.IsNullOrEmpty(passenger.Email)
                                        ? "—"
                                        : passenger.Email)
            </td>

                    <td>@passenger.Document</td>

                    <td>
                        <a asp-controller="Passengers"
                           asp-action="Details"
                           asp-route-id="@passenger.Id"
                           class="btn btn-sm btn-outline-primary">

                            @(Ui.Pick("Детальніше", "Details"))

                        </a>
                    </td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@passenger.Id"
                           class="btn btn-sm btn-warning">
                            @(Ui.Pick("Редагувати", "Edit"))
                        </a>
                        <form asp-action="Delete" asp-route-id="@passenger.Id"
                              method="post" class="d-inline">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('@(Ui.Pick("Видалити пасажира", "Delete passenger"))?')">
                                @(Ui.Pick("Видалити", "Delete"))
                            </button>
                        </form>
                    </td>
                </tr>
                }
        </tbody>

    </table>
}