@model RailwayTickets.Models.Passenger
@using RailwayTickets.Models

@{
    ViewData["Title"] = "Інформація про пасажира";

    var tickets = ViewBag.Tickets as List<Ticket>
                  ?? new List<Ticket>();
}

<h1>@Model.FullName</h1>

<p class="text-muted">
    Інформація про пасажира та його квитки.
</p>

<hr />

<div class="card mb-4">

    <div class="card-header">
        <strong>Дані пасажира</strong>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <p>
                    <strong>ПІБ:</strong><br />
                    @Model.FullName
                </p>

                <p>
                    <strong>Телефон:</strong><br />
                    @Model.Phone
                </p>

            </div>

            <div class="col-md-6">

                <p>
                    <strong>Email:</strong><br />

                    @(string.IsNullOrEmpty(Model.Email)
                                        ? "Не вказано"
                                        : Model.Email)
                </p>

                <p>
                    <strong>Документ:</strong><br />
                    @Model.Document
                </p>

            </div>

        </div>

    </div>

</div>

<h4>Квитки пасажира</h4>

@if (!tickets.Any())
{
    <div class="alert alert-info">
        У пасажира немає квитків.
    </div>
}
else
{
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">
            <tr>
                <th>Квиток</th>
                <th>Маршрут</th>
                <th>Рейс</th>
                <th>Вагон</th>
                <th>Місце</th>
                <th>Ціна</th>
                <th>Статус</th>
                <th>Дії</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var ticket in tickets)
            {
                <tr>

                    <td>@ticket.TicketNumber</td>

                    <td>
                        @ticket.Trip.Route.StartStation
                        →
                        @ticket.Trip.Route.EndStation
                    </td>

                    <td>@ticket.Trip.TripNumber</td>

                    <td>@ticket.CarriageNumber</td>

                    <td>@ticket.SeatNumber</td>

                    <td>
                        @ticket.Price.ToString("0.00") грн
                    </td>

                    <td>
                        @if (ticket.Status == "Заброньовано")
                        {
                            <span class="badge bg-warning text-dark">
                                Заброньовано
                            </span>
                        }
                        else if (ticket.Status == "Оформлено")
                        {
                            <span class="badge bg-success">
                                Оформлено
                            </span>
                        }
                        else if (ticket.Status == "Повернено")
                        {
                            <span class="badge bg-secondary">
                                Повернено
                            </span>
                        }
                        else if (ticket.Status == "Скасовано")
                        {
                            <span class="badge bg-danger">
                                Скасовано
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @ticket.Status
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-controller="Tickets"
                           asp-action="Details"
                           asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-outline-primary">

                            Переглянути

                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>
}

<a asp-controller="Passengers"
   asp-action="Index"
   class="btn btn-secondary">

    Назад до пасажирів

</a>