@model RailwayTickets.Models.Passenger
@using RailwayTickets.Models

@{
    ViewData["Title"] = Ui.Pick("Інформація про пасажира", "Passenger details");

    var tickets = ViewBag.Tickets as List<Ticket>
                  ?? new List<Ticket>();
}

<h1>@Model.FullName</h1>

<p class="text-muted">
    @(Ui.Pick("Інформація про пасажира та його квитки", "Passenger details and tickets")).
</p>

<hr />

<div class="card mb-4">

    <div class="card-header">
        <strong>@(Ui.Pick("Дані пасажира", "Passenger information"))</strong>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <p>
                    <strong>@(Ui.Pick("ПІБ", "Full name")):</strong><br />
                    @Model.FullName
                </p>

                <p>
                    <strong>@(Ui.Pick("Телефон", "Phone")):</strong><br />
                    @Model.Phone
                </p>

            </div>

            <div class="col-md-6">

                <p>
                    <strong>Email:</strong><br />

                    @(string.IsNullOrEmpty(Model.Email)
                                        ? "Не вказано"
                                        : Model.Email)
                </p>

                <p>
                    <strong>@(Ui.Pick("Документ", "Document")):</strong><br />
                    @Model.Document
                </p>

            </div>

        </div>

    </div>

</div>

<h4>@(Ui.Pick("Квитки пасажира", "Passenger tickets"))</h4>

@if (!tickets.Any())
{
    <div class="alert alert-info">
        @(Ui.Pick("У пасажира немає квитків", "This passenger has no tickets")).
    </div>
}
else
{
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">
            <tr>
                <th>@(Ui.Pick("Квиток", "Ticket"))</th>
                <th>@(Ui.Pick("Маршрут", "Route"))</th>
                <th>@(Ui.Pick("Рейс", "Trip"))</th>
                <th>@(Ui.Pick("Вагон", "Carriage"))</th>
                <th>@(Ui.Pick("Місце", "Seat"))</th>
                <th>@(Ui.Pick("Ціна", "Price"))</th>
                <th>@(Ui.Pick("Статус", "Status"))</th>
                <th>@(Ui.Pick("Дії", "Actions"))</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var ticket in tickets)
            {
                <tr>

                    <td>@ticket.TicketNumber</td>

                    <td>
                        @Ui.Station(ticket.Trip.Route.StartStation)
                        →
                        @Ui.Station(ticket.Trip.Route.EndStation)
                    </td>

                    <td>@ticket.Trip.TripNumber</td>

                    <td>@ticket.CarriageNumber</td>

                    <td>@ticket.SeatNumber</td>

                    <td>
                        @ticket.Price.ToString("0.00") @(Ui.Pick("грн", "UAH"))
                    </td>

                    <td>
                        @if (ticket.Status == "Заброньовано")
                        {
                            <span class="badge bg-warning text-dark">
                                @(Ui.Pick("Заброньовано", "Reserved"))
                            </span>
                        }
                        else if (ticket.Status == "Оформлено")
                        {
                            <span class="badge bg-success">
                                @(Ui.Pick("Оформлено", "Issued"))
                            </span>
                        }
                        else if (ticket.Status == "Повернено")
                        {
                            <span class="badge bg-secondary">
                                @(Ui.Pick("Повернено", "Refunded"))
                            </span>
                        }
                        else if (ticket.Status == "Скасовано")
                        {
                            <span class="badge bg-danger">
                                @(Ui.Pick("Скасовано", "Cancelled"))
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Ui.Status(ticket.Status)
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-controller="Tickets"
                           asp-action="Details"
                           asp-route-id="@ticket.Id"
                           class="btn btn-sm btn-outline-primary">

                            @(Ui.Pick("Переглянути", "View"))

                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>
}

<a asp-controller="Passengers"
   asp-action="Index"
   class="btn btn-secondary">

    @(Ui.Pick("Назад до пасажирів", "Back to passengers"))

</a>