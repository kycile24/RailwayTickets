<h1>@(Ui.Pick("Вхід", "Sign in"))</h1>
<form asp-action="Login" method="post" class="col-md-5">
    <div asp-validation-summary="All" class="text-danger"></div>
    <label class="form-label">@(Ui.Pick("Логін", "Username")) <input name="login" required class="form-control" autocomplete="username" /></label>
    <label class="form-label">@(Ui.Pick("Пароль", "Password")) <input name="password" type="password" required class="form-control" autocomplete="current-password" /></label>
    <p><label><input type="checkbox" name="staff" value="true" /> @(Ui.Pick("Я працівник залізниці", "I am a railway employee"))</label></p>
    <button class="btn btn-primary">@(Ui.Pick("Увійти", "Sign in"))</button>
    <a asp-action="Register">@(Ui.Pick("Реєстрація клієнта", "Passenger registration"))</a>
</form>
