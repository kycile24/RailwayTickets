@model RailwayTickets.Models.Trip

@{
    ViewData["Title"] = Ui.Pick("Рейс", "Trip");
}

<h1>
    @(Ui.Pick("Рейс", "Trip")) @Model.TripNumber
</h1>

<p class="text-muted">
    @Ui.Station(Model.Route.StartStation)
    →
    @Ui.Station(Model.Route.EndStation)
</p>

<hr />


<div class="row">

    <div class="col-md-6">

        <h4>@(Ui.Pick("Інформація про рейс", "Trip details"))</h4>

        <table class="table">

            <tr>
                <th>@(Ui.Pick("Маршрут", "Route"))</th>
                <td>@Model.Route.Name</td>
            </tr>

            <tr>
                <th>@(Ui.Pick("Відправлення", "Departure"))</th>

                <td>
                    @Model.DepartureDate.ToString("dd.MM.yyyy HH:mm")
                </td>
            </tr>

            <tr>
                <th>@(Ui.Pick("Прибуття", "Arrival"))</th>

                <td>
                    @Model.ArrivalDate.ToString("dd.MM.yyyy HH:mm")
                </td>
            </tr>

            <tr>
                <th>@(Ui.Pick("Вартість", "Fare"))</th>

                <td>
                    @Model.BasePrice.ToString("0.00") @(Ui.Pick("грн", "UAH"))
                </td>
            </tr>

        </table>

    </div>


    <div class="col-md-6">

        <h4>@(Ui.Pick("Потяг", "Train"))</h4>

        <table class="table">

            <tr>
                <th>@(Ui.Pick("Номер", "Number"))</th>
                <td>@Model.Train.TrainNumber</td>
            </tr>

            <tr>
                <th>@(Ui.Pick("Тип", "Type"))</th>
                <td>@Model.Train.Type</td>
            </tr>

            <tr>
                <th>@(Ui.Pick("Вагонів", "Carriages"))</th>
                <td>@Model.Train.CarriageCount</td>
            </tr>

        </table>

    </div>

</div>


<h4 class="mt-4">
    @(Ui.Pick("Вагони", "Carriages"))
</h4>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>@(Ui.Pick("Вагон", "Carriage"))</th>
            <th>@(Ui.Pick("Тип", "Type"))</th>
            <th>@(Ui.Pick("Місць", "Seats"))</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var carriage in Model.Train.Carriages)
        {
            <tr>
                <td>@carriage.CarriageNumber</td>
                <td>@carriage.CarriageType</td>
                <td>@carriage.SeatCount</td>
            </tr>
        }

    </tbody>

</table>


<a asp-action="Index"
   class="btn btn-secondary">

    @(Ui.Pick("Назад", "Back"))

</a>

<a asp-controller="Tickets"
   asp-action="Book"
   asp-route-tripId="@Model.Id"
   class="btn btn-success">

    @(Ui.Pick("Забронювати квиток", "Book ticket"))

</a>