@model IEnumerable<RailwayTickets.Models.Trip>

@{
    ViewData["Title"] = Ui.Pick("Рейси", "Trips");
}

<h1 class="mb-4">@(Ui.Pick("Пошук рейсів", "Find trips"))</h1>


<div class="card shadow-sm mb-4">

    <div class="card-body">

        <form asp-controller="Trips"
              asp-action="Index"
              method="get">

            <div class="row g-3">

                <div class="col-md-4">

                    <label class="form-label">
                        @(Ui.Pick("Звідки", "From"))
                    </label>

                    <input type="text"
                           name="startStation"
                           value="@Ui.Station(ViewBag.StartStation)"
                           class="form-control"
                           placeholder="@(Ui.Pick("Київ", "Kyiv"))" />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        @(Ui.Pick("Куди", "To"))
                    </label>

                    <input type="text"
                           name="endStation"
                           value="@Ui.Station(ViewBag.EndStation)"
                           class="form-control"
                           placeholder="@(Ui.Pick("Львів", "Lviv"))" />

                </div>


                <div class="col-md-2">

                    <label class="form-label">
                        @(Ui.Pick("Дата", "Date"))
                    </label>

                    <input type="date"
                           name="departureDate"
                           value="@ViewBag.DepartureDate"
                           class="form-control" />

                </div>


                <div class="col-md-2 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        @(Ui.Pick("Знайти", "Search"))

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>


@if (!Model.Any())
{
    <div class="alert alert-warning">
        @(Ui.Pick("За заданими параметрами рейсів не знайдено", "No trips match your search")).
    </div>
}
else
{
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">

            <tr>
                <th>@(Ui.Pick("Рейс", "Trip"))</th>
                <th>@(Ui.Pick("Маршрут", "Route"))</th>
                <th>@(Ui.Pick("Відправлення", "Departure"))</th>
                <th>@(Ui.Pick("Прибуття", "Arrival"))</th>
                <th>@(Ui.Pick("Потяг", "Train"))</th>
                <th>@(Ui.Pick("Ціна", "Price"))</th>
                <th></th>
            </tr>

        </thead>

        <tbody>

            @foreach (var trip in Model)
            {
                <tr>

                    <td>
                        <strong>@trip.TripNumber</strong>
                    </td>

                    <td>
                        @Ui.Station(trip.Route.StartStation)
                        →
                        @Ui.Station(trip.Route.EndStation)
                    </td>

                    <td>
                        @trip.DepartureDate.ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>
                        @trip.ArrivalDate.ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>
                        @trip.Train.TrainNumber
                    </td>

                    <td>
                        @trip.BasePrice.ToString("0.00") @(Ui.Pick("грн", "UAH"))
                    </td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@trip.Id"
                           class="btn btn-outline-primary btn-sm">

                            @(Ui.Pick("Детальніше", "Details"))

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}