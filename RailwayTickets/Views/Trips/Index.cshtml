@model IEnumerable<RailwayTickets.Models.Trip>

@{
    ViewData["Title"] = "Рейси";
}

<h1 class="mb-4">Пошук рейсів</h1>


<div class="card shadow-sm mb-4">

    <div class="card-body">

        <form asp-controller="Trips"
              asp-action="Index"
              method="get">

            <div class="row g-3">

                <div class="col-md-4">

                    <label class="form-label">
                        Звідки
                    </label>

                    <input type="text"
                           name="startStation"
                           value="@ViewBag.StartStation"
                           class="form-control"
                           placeholder="Київ" />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Куди
                    </label>

                    <input type="text"
                           name="endStation"
                           value="@ViewBag.EndStation"
                           class="form-control"
                           placeholder="Львів" />

                </div>


                <div class="col-md-2">

                    <label class="form-label">
                        Дата
                    </label>

                    <input type="date"
                           name="departureDate"
                           value="@ViewBag.DepartureDate"
                           class="form-control" />

                </div>


                <div class="col-md-2 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        Знайти

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>


@if (!Model.Any())
{
    <div class="alert alert-warning">
        За заданими параметрами рейсів не знайдено.
    </div>
}
else
{
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark">

            <tr>
                <th>Рейс</th>
                <th>Маршрут</th>
                <th>Відправлення</th>
                <th>Прибуття</th>
                <th>Потяг</th>
                <th>Ціна</th>
                <th></th>
            </tr>

        </thead>

        <tbody>

            @foreach (var trip in Model)
            {
                <tr>

                    <td>
                        <strong>@trip.TripNumber</strong>
                    </td>

                    <td>
                        @trip.Route.StartStation
                        →
                        @trip.Route.EndStation
                    </td>

                    <td>
                        @trip.DepartureDate.ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>
                        @trip.ArrivalDate.ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>
                        @trip.Train.TrainNumber
                    </td>

                    <td>
                        @trip.BasePrice.ToString("0.00") грн
                    </td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@trip.Id"
                           class="btn btn-outline-primary btn-sm">

                            Детальніше

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}