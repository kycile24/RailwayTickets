@{ ViewData["Title"] = Ui.Pick("Звіт про продажі", "Sales report"); }
<h1>@(Ui.Pick("Звіт про продажі", "Sales report"))</h1>
    <form method="get" asp-controller="Queries" asp-action="Index"
          class="row g-3 mb-3">

        <div class="col-md-4">
            <label class="form-label">@(Ui.Pick("Дата від", "From date"))</label>
            <input type="date"
                   name="dateFrom"
                   value="@ViewBag.DateFrom"
                   class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">@(Ui.Pick("Дата до", "To date"))</label>
            <input type="date"
                   name="dateTo"
                   value="@ViewBag.DateTo"
                   class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">
                @(Ui.Pick("Розрахувати", "Calculate"))
            </button>
        </div>
    </form>


    <div class="alert alert-success">
        @(Ui.Pick("Вартість оформлених та оплачених квитків за датою відправлення", "Total value of issued and paid tickets by departure date")):
        <strong>@ViewBag.TotalIncome @(Ui.Pick("грн", "UAH"))</strong>
    </div>

