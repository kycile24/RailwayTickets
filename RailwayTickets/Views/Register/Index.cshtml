@model List<CashShift>
<h1>@(Ui.Pick("Касові зміни та звіти", "Cash shifts and reports"))</h1>
@if (TempData["ShiftError"] is string message) { <p class="alert alert-warning">@message</p> }
@if (User.IsInRole("Cashier") && !Model.Any(s => s.Closed == null))
{
    <form asp-action="Open" method="post"><button class="btn btn-primary">@(Ui.Pick("Відкрити зміну", "Open shift"))</button></form>
}
@foreach (var shift in Model)
{
    <section class="card p-3 mt-3">
        <h2>@(Ui.Pick("Зміна", "Shift")) №@shift.Id</h2>
        <p>@(Ui.Pick("Касир", "Cashier")) №@shift.CashierId · @(Ui.Pick("Відкрито", "Opened")) @shift.Opened · @(Ui.Pick("Закрито", "Closed")) @(shift.Closed?.ToString() ?? "—")</p>
        <table class="table"><thead><tr><th>@(Ui.Pick("Час", "Time"))</th><th>@(Ui.Pick("Квиток", "Ticket"))</th><th>@(Ui.Pick("Операція", "Operation"))</th><th>@(Ui.Pick("Працівник", "Employee"))</th><th>@(Ui.Pick("Сума", "Amount")), @(Ui.Pick("грн", "UAH"))</th><th>@(Ui.Pick("Корекція", "Adjustment"))</th></tr></thead><tbody>
        @foreach (var entry in shift.Entries.OrderBy(e => e.Id))
        {
            <tr><td>@entry.Recorded</td><td><a asp-controller="Tickets" asp-action="Details" asp-route-id="@entry.TicketId">№@entry.TicketId</a></td>
                <td>@entry.PreviousStatus → @entry.NewStatus</td><td>@entry.ActorId</td><td>@entry.Amount</td><td>
                @if (entry.ReversesId != null) { <span>@(Ui.Pick("Анулювання", "Reversal")) №@entry.ReversesId · @entry.Reason</span> }
                else if (User.IsInRole("Administrator") && shift.Approved == null && !shift.Entries.Any(e => e.ReversesId == entry.Id))
                {
                    <form asp-action="Reverse" asp-route-id="@entry.Id" method="post"><input name="reason" required placeholder="@(Ui.Pick("Причина", "Reason"))" /><button>@(Ui.Pick("Анулювати", "Reverse")) №@entry.Id</button></form>
                }</td></tr>
        }
        </tbody></table>
        <p>@(Ui.Pick("Підсумок зміни", "Shift summary")): <strong>@shift.Entries.Sum(e => e.Amount) @(Ui.Pick("грн", "UAH"))</strong></p>
        @if (shift.Closed.HasValue) { <h3>@(Ui.Pick("Баланс місць на час закриття", "Seat balance at closing"))</h3><pre>@shift.SeatBalance</pre> }
        @if (User.IsInRole("Cashier") && shift.Closed == null)
        {
            <form asp-action="Close" asp-route-id="@shift.Id" method="post"><button>@(Ui.Pick("Звірити місця і закрити зміну", "Reconcile seats and close shift"))</button></form>
        }
        @if (User.IsInRole("Administrator") && shift.Closed != null && shift.Approved == null)
        {
            <form asp-action="Approve" asp-route-id="@shift.Id" method="post"><button>@(Ui.Pick("Затвердити звіт", "Approve report"))</button></form>
        }
        @if (shift.Approved.HasValue) { <p>@(Ui.Pick("Затвердив адміністратор", "Approved by administrator")) №@shift.ApprovedBy · @shift.Approved</p> }
    </section>
}
